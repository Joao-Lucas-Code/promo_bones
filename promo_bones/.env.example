# Token do bot do Telegram (obrigatório)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# ID do grupo/canal do Telegram (opcional)
TELEGRAM_GROUP_ID=

# Tag de afiliado Mercado Livre (opcional)
ML_AFFILIATE_TAG=

# Tag de afiliado Amazon (opcional)
AMAZON_AFFILIATE_TAG=

# Intervalo do scraper em minutos (padrão: 60)
SCRAPER_INTERVAL=60

# Credenciais do painel admin (deixe ADMIN_USERNAME vazio para desabilitar a auth no desenvolvimento)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mude_para_uma_senha_forte
